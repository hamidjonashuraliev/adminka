 <%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/login.css" />
<body>
    

    <div class="section-hero">
        <div class="video-container">
          <video class="video" loop muted autoplay playsinline src="https://github.com/Pierrinho/stock/raw/refs/heads/master/70796-538877060_small.mp4"></video>
        </div>
       
      </div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
  const tl = gsap.timeline();

  tl.fromTo('.video-container',
    { 
      y: '100%',
    },
    { 
      y: 0, 
      duration: 1.2, 
      ease: 'power2.out'
    }
  );
  
  tl.fromTo('.video-container',
    { 
      clipPath: 'polygon(30% 30%, 70% 30%, 70% 70%, 30% 70%)',
    },
    { 
      clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)',
      duration: 1, 
      ease: 'power2.in'
    }, '-=0.5'
  );

  tl.add(() => {
    const split = new SplitText('.title', { type: 'lines' });

    gsap.set('.title', { visibility: 'visible' });

    gsap.from(split.lines, {
      opacity: 0,
      y: 50,
      stagger: 0.2,
      duration: 1,
      ease: 'power3.out'
    });
  });
  
});

</script>


    <form class="login_container" action="/resto/login" method="POST">
        <div class="login_frame">
            <div class="login_top">
                <span tabindex="0">Login to Page</span>
            </div>
            <div class="top">
                <p>Back to <a href="/resto">Home</a> Page</p>
                <p>Not yet signed up? <a href="/resto/sign-up">Sign up</a></p>
            </div>
            <div class="login_input_frame">
                <div class="login_input_container">
                    <label tabindex="0">Username: </label>
                    <input
                        type="text"
                        name="mb_nick"
                        placeholder="Enter Username "
                        value=""
                        required
                    />
                </div>
                <div class="login_input_container">
                    <label tabindex="0">Password:</label>
                    <input
                        type="password"
                        name="mb_password"
                        placeholder="Enter Password"
                        value=""
                        required
                    />
                </div>
            </div>
            <button class="login_btn" name="login" type="submit">Login</button>
        </div>
    </form>
</body>

<%- include('includes/footer') %> 




