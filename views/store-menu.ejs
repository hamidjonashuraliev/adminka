<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/menu.css" />
<body>
    <div id="main_container">
        <div class="group_name1">
            <ul class="nav1 justify-content-center">
                <li class="nav-item1" style="cursor: pointer">
                    <a class="nav-link1 active" href="/resto">Home</a>
                </li>
                <li class="nav-item1" style="cursor: pointer">
                    <a class="nav-link1" href="/resto/products/menu">My Store</a>
                </li>
                <li class="nav-item1" style="cursor: pointer">
                    <a class="nav-link1" href="/resto/logout">Logout</a>
                </li>
            </ul>
        </div>
        <div class="store_menu_frame">
            <div class="store_container">
                <div class="device_table">
                    <span class="new_device_txt"><%= member.mb_nick.toUpperCase() %> Products Menu
                    </span>
                    <table class="table table-bordered table-hover">
                      <thead class="thead-light">
                        <th scope="col">T/r</th>
                        <th scope="col">Device Item</th>
                        <th scope="col">Type</th>
                        <th scope="col">Volume/Size</th>
                        <th scope="col">Price</th>
                        <th scope="col">Availability Count</th>
                        <th scope="col">Device Specs</th>
                        <th scope="col">Device Status</th>
                      </thead>
                      <% store_data.map((value, key) => {  %>
                        <tbody style="background: #ffff;">
                            <td><%= key +1 %></td>
                            <td><%= value.product_name  %></td>
                            <td><%= value.product_collection  %></td>
                            <td><%= ["laptop", "monitor", "planshet", "watch"].includes(value.product_collection) ? value.product_volume  : value.product_size %></td>
                            <td><%= value.product_price  %></td>
                            <td><%= value.product_left_cnt  %></td>
                            <td><%= value.product_specs  %></td>
                            <td>
                                <select class="spec_select new_product_status" id="<%= value._id %>">
                                    <option value="PAUSED" <%= value.product_status === 'PAUSED' ? 'selected' : '' %> > PAUSED </option>
                                    <option value="PROCESS" <%= value.product_status === 'PROCESS' ? 'selected' : '' %> > PROCESS </option>
                            </select>
                            </td>
                          </tbody>
                        <% }) %>

                      </table>

                      <div class="long_input" style="align-items: flex-end; margin-bottom: 25px;" >
                        <button class="btn btn-primary hiding_btn"> Add new menu item</button>
                        </div>
                </div>

                <form onsubmit="return validateForm()" action="/resto/products/create" method="POST" class="device_container" enctype="multipart/form-data">
                    <div class="long_input" style=" display: flex; align-items: center;">
                        <span class="new_device_txt"> New Menu Item</span>

                    </div>
                   <div>
                    <div class="long_input">
                        <label>Name</label>
                        <input type="text" placeholder="Device nomi" name="product_name" class="product_name">
                    </div>
                    <input value="PAUSED" name="product_status" class="product_status" hidden>
                   </div>
                    <div class="half_input_frame">
                        <div class="half_input">
                            <label>Price</label>
                            <input type="number" placeholder="Device  narxi" name="product_price" class="product_price">
                        </div>
                        <div class="half_input">
                            <label>Availability Count</label>
                            <input type="number" placeholder="Device mavjud miqdori" name="product_left_cnt" class="product_left_cnt">
                        </div>
                    </div>
                    <div class="half_input_frame">
                        <div class="half_input">
                            <label >Device Type</label>
                            <select class="product_collection" name="product_collection" >
                                <option value="laptop" selected>Portable Computing Device</option>
                                <option value="smartphone">Mobile Communication Device</option>
                                <option value="keyboard">Input Device</option>
                                <option value="mouse">Pointing Device</option>
                                <option value="charger">Power Supply Device</option>
                                <option value="airpods">Wireless Audio Device</option>
                                <option value="headphone">Audio Output Device</option>
                                <option value="planshet">Tablet Computing Device</option>
                                <option value="usb">Data Storage and Transfer Device</option>
                                <option value="vr">Immersive Technology Device</option>
                                <option value="watch">Wearable Device</option>
                                <option value="monitor">Display Device</option>
                                <option value="accessory">Accessory</option>
                            </select>
                        </div>

                        <div class="half_input" id="product_size">
                            <label >Device Size</label>
                            <select class="product_size" name="product_size" >
                                <option value="inch 13-17">Laptop:  Normal</option>
                                <option value="inch 24-32">Monitor: Large</option>
                                <option value="inch 8-12">Planshet </option>
                                <option value="inch 1.4-1.6">Watch </option>

                                <option value="compact ">Watch: Compact </option>
                                <option value="large ">large: Compact </option>
                                <option value="normal ">Planshet: Compact </option>
                                <option value="compact ">Watch: Compact </option>
                            </select>
                        </div>

                        <div class="half_input" id="product_volume" style="display: none;">
                            <label >Device volume</label>
                            <select class="product_volume" name="product_volume" >
                                <option value="84(sm³) ">Smartphone:  Compact</option>
                                <option value="42(sm³) ">Keyboard:  Tenkeyless</option>
                                <option value="2160(sm³) ">Headphone:  Over-ear</option>
                                <option value="4.5(sm³)">USB:  Small</option>
                                <option value="2400(sm³)">VR:  Large</option>
                                <option value="288(sm³)">Mouse:  Normal</option>
                                <option value="90(sm³)">Charger:  High-power</option>
                                <option value="40(sm³)">AirPods: Over-ear </option>
                                <option value="dB ">AirPods	: Over-ear</option>
                                <option value="mAh ">Charger: High-power</option>
                                <option value="W ">Headphone: Normal</option>
                            </select>

                        </div>
                        <div class="half_input">
                            <label >Device specs</label>
                            <select class="product_specs" name="product_specs" >
                                <option value="Storage Laptop"  > Storage Laptop: 256GB-2TB</option>
                                <option value="Storage Smartphone"  > Storage Smartphone: 64GB-1TB</option>
                                <option value="Storage Planshet"  > Storage Planshet: 128GB-1TB</option>
                                <option value="Storage USB"  > Storage USB: 16GB-1TB</option>
                                <option value="Storage Watch"  > Storage Watch: 4-32GB</option>
                                <option value="CPU Laptop"  > CPU Laptop: Intel/AMD,</option>
                                <option value="CPU Smartphone"  > CPU Smartphone: Snapdragon/Apple</option>
                                <option value="CPU Planshet"  > CPU Planshet: Apple M1/Snapdragon</option>
                                <option value="CPU Watch"  >CPU Watch: Wear OS/Apple</option>
                                <option value="RAM Laptop"  > RAM Laptop: 8-64GB</option>
                                <option value="RAM Smartphone"  > RAM Smartphone: 4-16GB</option>
                                <option value="RAM Planshet"  > RAM Planshet: 4-16GB</option>
                                <option value="Type Keyboard"  > Type Keyboard: Mechanical/Membrane</option>
                                <option value="Type Usb"  >Type: USB 2.0/3.0/3.1/USB-C</option>
                                <option value="Type Mouse"  >Type: Optical/Laser</option>
                                <option value="Type Charger"  >Type Charger: Fast/Standard Charging</option>
                                <option value="Type VR"  >Type VR: Standalone/PC VR</option>
                                <option value="Type Monitor"  >Type: LED/OLED</option>
                                <option value="Power Output Headphone"  > Power Output Headphone: 30-50mW</option>
                                <option value="Power Output AirPods"  > Battery: 5-20mW</option>
                                <option value="Power Output Charger"  > Battery Charger: 10W-100W</option>
                                <option value="Power Output AirPods"  > Power Output AirPods: 5-20mW</option>
                                <option value="Driver Size Headphone"  > Driver Size Headphone: 40-50mm</option>
                                <option value="Driver Size AirPods"  > Driver Size AirPods: 10-14mm</option>
                                <option value="Input Keyboard"  >  Input Keyboard: USB/Wireless</option>
                                <option value="Input Monitor"  >  InputMonitor: HDMI, DisplayPort</option>
                                <option value="Input Mouse"  > Input Mouse: Wired/Wireless</option>
                                <option value="Input VR"  > Input VR: Controllers, Hand Tracking</option>
                                <option value="Input Charger"  > Input Charger: USB-A/C</option>
                                <option value="Connectivity Laptop"  > Connectivity Laptop: Wi-Fi, Bluetooth, USB</option>
                                <option value="Connectivity Smartphone"  > Connectivity Smartphone: 5G, Wi-Fi, Bluetooth</option>
                                <option value="Connectivity Keyboard"  >Connectivity Keyboard: Bluetooth, 2.4GHz</option>
                                <option value="Connectivity Monitor"  > Connectivity Monitor: USB-C, Wi-Fi</option>
                                <option value="Connectivity Planshet"  > Connectivity Planshet: Wi-Fi, LTE</option>
                                <option value="Connectivity USB"  > Connectivity USB: PC, Phone, Console</option>
                                <option value="Connectivity VR"  > Connectivity VR: Wi-Fi, Bluetooth</option>
                                <option value="Connectivity Watch"  > Connectivity Watch: Bluetooth, GPS, LTE</option>
                                <option value="Connectivity Mouse"  > Connectivity Mouse: Bluetooth, 2.4GHz</option>
                                <option value="Resolution Monitor"  > Resolution Monitor: Full HD/4K</option>
                                <option value="Battery Smartphone"  > Battery Smartphone: 5000-10000mAh</option>
                                <option value="Battery Watch"  > Battery Watch: 200-600mAh</option>
                                <option value="Battery Planshet	"  > Battery Planshet: 5000-10000mAh</option>
                                <option value="Bluetooth Headphone"  > Bluetooth Headphone: 5.0+, Noise</option>
                                <option value="Bluetooth AirPods"  > Bluetooth AirPods: 5.0+, Noise</option>
                            </select>
                        </div>
                    </div>
                    <div class="long_input">
                        <label>About Menu Item</label>
                        <textarea name="product_description"  class="product_description"></textarea>
                    </div>

                    <div class="img_frame">
                        <label>Menu Item Pictures</label>
                        <div class="media_frame">
                            <div class="upload_img_box">
                                <img src="/images/upload.svg" class="upload-trigger" data-target="image_one" id="image_section_1">
                                <input type="file" name="product_images" class="image_one" onchange="previewFileHandler(this, 1)" hidden>
                            </div>
                            <div class="upload_img_box">
                                <img src="/images/upload.svg" class="upload-trigger" data-target="image_two" id="image_section_2">
                                <input type="file" name="product_images" class="image_two" onchange="previewFileHandler(this, 2)" hidden>
                            </div>
                            <div class="upload_img_box">
                                <img src="/images/upload.svg" class="upload-trigger" data-target="image_three" id="image_section_3">
                                <input type="file" name="product_images" class="image_three" onchange="previewFileHandler(this, 3)" hidden>
                            </div>
                            <div class="upload_img_box">
                                <img src="/images/upload.svg" class="upload-trigger" data-target="image_four" id="image_section_4">
                                <input type="file" name="product_images" class="image_four" onchange="previewFileHandler(this, 4)" hidden>
                            </div>
                            <div class="upload_img_box">
                                <img src="/images/upload.svg" class="upload-trigger" data-target="image_five" id="image_section_5">
                                <input type="file" name="product_images" class="image_five" onchange="previewFileHandler(this, 5)" hidden>
                            </div>
                            <input value="<%= member._id%>" name="store_id" class="store_is" hidden>
                        </div>
                    </div>

                    <div class="long_input" style="align-items: flex-end; margin-bottom: 25px;">
                        <button type="submit" class="btn btn-primary" id="create_product">PRINT</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
       $(function() {
    $(".product_collection").on("change", function() {
        const selected_value = $(".product_collection").val();
        if (["laptop", "monitor", "planshet", "watch"].includes(selected_value)) {
            $("#product_size").show();
            $("#product_volume").hide();
        } else {
            $("#product_size").hide();
            $("#product_volume").show();
        }
    });
});
            $(".hiding_btn").on("click", () => {
              $(".device_container").slideToggle(500);
                $(".hiding_btn").css("display", "none");
            });

            // product status changer

            $(".new_product_status").on("change", async function (e) {
                const id = e.target.id;
              const product_status  = $(`#${id}.new_product_status`).val();
            // const mb_id = '<%= member._id%>';

            try {
                const response = await axios.post(`/resto/products/edit/${id}`, {id: id, product_status: product_status} );

                const result = response.data;
                console.log("result:", result)

                if (result.state == 'success') {
                    alert('success');
                    location.reload();

                } else {
                    alert(result.message)
                }

            } catch (err) {
                console.log('updateChosenProduct err: ', err);

            }});

        function validateForm() {
      const restaurant_mb_id = $(".restaurant_mb_id").val(),
        product_name = $(".product_name").val(),
        product_price = $(".product_price").val(),
        product_left_cnt= $(".product_left_cnt").val(),
        product_collection = $(".product_collection").val(),
        product_description = $(".product_description").val(),
        product_status = $(".product_status").val(),
        product_specs = $(".product_specs").val();

        if(restaurant_mb_id == '' || product_name == '' || product_price == '' || product_left_cnt == '' ||
          product_collection == '' || product_description == '' || product_status == '' || product_specs == '' ) {
            alert(`Please enter all fields!`);
            return false;
          } else return true;
    }

    function previewFileHandler(input, order) {

        const image_class_name = input.className;
        const file = $(`.${image_class_name}`).get(0).files[0],
        fileType = file['type'];
        validImageTypes = ["image/jpg", "image/jpeg", "image/png"];

        if(!validImageTypes.includes(fileType))  {
            alert('Please upload allowed image formats: jpg, jpeg, or png!');
        } else {
            if(file) {
                let reader = new FileReader();
                reader.onload = function () {
                    $(`#image_section_${order}`).attr("src", reader.result);

                }
                reader.readAsDataURL(file);
            }
        }

    }

    document.querySelectorAll('.upload-trigger').forEach(img => {
        img.addEventListener('click', function() {
            let target = this.getAttribute('data-target'); // data-target atributini olish
            document.querySelector(`.${target}`).click(); // Shu classdagi inputni bosish
        });
    });
    </script>


</body>

<%- include('includes/footer') %>
